# Auto-generated by generate_rest_file.py from src/server.py
# MCP JSON-RPC over Streamable HTTP. Adjust @url if the server endpoint differs.

@url = http://localhost:8000/mcp

### analyze_code — Statically analyze a Python file for security vulnerabilities using
# file_path: str (required)
# min_severity: str (default='LOW')
# top_k: int (default=6)
POST {{url}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "analyze_code",
    "arguments": {
      "file_path": "<string>",
      "min_severity": "LOW",
      "top_k": 6
    }
  }
}

